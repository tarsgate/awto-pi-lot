-for (let i = 0; i < args.length; i++) {
-	if (args[i] === "--dir" || args[i] === "-d") {
-		directory = args[++i];
-	} else if (args[i] === "--days" || args[i] === "-n") {
-		days = parseInt(args[++i], 10);
