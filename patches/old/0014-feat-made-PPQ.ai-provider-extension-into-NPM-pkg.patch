-				Math.round(Math.max(0, Math.min(255, x)))
-					.toString(16)
-					.padStart(2, "0"),
-			)
-			.join("")
-	);
-}
-
-function rgbToHsl(r: number, g: number, b: number): [number, number, number] {
-	r /= 255;
-	g /= 255;
-	b /= 255;
-	const max = Math.max(r, g, b),
-		min = Math.min(r, g, b);
-	let h = 0,
