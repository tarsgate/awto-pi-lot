-	}
-
-	setTitle(title: string): void {
-		// OSC 0;title BEL - set terminal window title
-		this.xterm.write(`\x1b]0;${title}\x07`);
-	}
-
-	// Test-specific methods not in Terminal interface
-
-	/**
-	 * Simulate keyboard input
-	 */
-	sendInput(data: string): void {
